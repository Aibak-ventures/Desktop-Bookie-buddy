{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "bookie_buddy_web",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=FULL_NETWORK_LOG=true"
            ],
            "deviceId": "chrome"
        },
        {
            "name": "Flutter: Run Dev",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=PROD=false"
            ],
            "deviceId": "chrome"
        },
        {
            "name": "Flutter: Run Dev (MOCK_PRINTER)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=PROD=false",
                "--dart-define=MOCK_PRINTER=true"
            ],
            "deviceId": "chrome"
        },
        {
            "name": "Flutter: Run Prod",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=PROD=true"
            ],
            "deviceId": "chrome"
        },
    ]
}
